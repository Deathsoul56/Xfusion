/* Stylesheet shared by every theme. @NAME@ tokens are replaced by Theme::apply() with the colours of the chosen theme. */

QMainWindow,
QDialog {
    background-color: @BG_WINDOW@;
}

QStackedWidget > QWidget,
QScrollArea > QWidget > QWidget {
    background-color: @BG_WINDOW@;
}

QStatusBar {
    background-color: @BG_PANEL@;
    color: @TEXT_MUTED@;
    border-top: 1px solid @BORDER@;
}

QStatusBar::item {
    border: none;
}

QToolTip {
    background-color: @BG_PANEL@;
    color: @TEXT@;
    border: 1px solid @BORDER@;
    padding: 4px 8px;
}

/* Menus */
QMenuBar {
    background-color: @BG_PANEL@;
    color: @TEXT@;
    border-bottom: 1px solid @BORDER@;
}

QMenuBar::item {
    padding: 6px 12px;
    background: transparent;
}

QMenuBar::item:selected {
    background-color: @BORDER@;
    color: @TEXT_BRIGHT@;
}

QMenu {
    background-color: @BG_PANEL@;
    border: 1px solid @BORDER@;
    color: @TEXT@;
    padding: 4px;
}

QMenu::item {
    padding: 6px 22px;
    border-radius: 4px;
}

QMenu::item:selected {
    background-color: @BORDER@;
    color: @TEXT_BRIGHT@;
}

QMenu::item:disabled {
    color: @TEXT_DISABLED@;
}

QMenu::separator {
    height: 1px;
    margin: 4px 6px;
    background-color: @BORDER_LIGHT@;
}

QMenu::indicator {
    subcontrol-position: right center;
    subcontrol-origin: padding;
    right: 8px;
}

QMenu::indicator:checked {
    image: url(:/icons/check@SHADE@.svg);
    width: 16px;
    height: 16px;
}

/* Settings sidebar */
QListWidget#panelList {
    background-color: @BG_PANEL@;
    border: none;
    outline: 0;
    padding: 8px 0;
}

QListWidget#panelList::item {
    color: @TEXT_MUTED@;
    padding: 10px 14px;
    border-radius: 6px;
    margin: 2px 8px;
}

QListWidget#panelList::item:hover {
    background-color: @BG_ELEVATED@;
    color: @TEXT_BRIGHT@;
}

QListWidget#panelList::item:selected {
    background-color: @BORDER@;
    color: @TEXT_BRIGHT@;
}

/* Tables */
QTableWidget {
    background-color: @BG_WINDOW@;
    alternate-background-color: @BG_ALT@;
    gridline-color: @BORDER@;
    border: 1px solid @BORDER@;
    selection-background-color: @ACCENT_DARK@;
    selection-color: #ffffff;
    outline: 0;
}

QTableWidget::item {
    padding: 4px 8px;
    border: none;
}

QTableWidget::item:selected {
    background-color: @ACCENT_DARK@;
    color: #ffffff;
}

QHeaderView::section {
    background-color: @BG_PANEL@;
    color: @TEXT_MUTED@;
    padding: 6px 8px;
    border: none;
    border-bottom: 1px solid @BORDER@;
    font-weight: 600;
}

QTableCornerButton::section {
    background-color: @BG_PANEL@;
    border: none;
}

/* Buttons */
QPushButton {
    background-color: @BG_ELEVATED@;
    border: 1px solid @BORDER@;
    border-radius: 6px;
    padding: 6px 14px;
    color: @TEXT@;
}

QPushButton:hover {
    background-color: @BORDER@;
    color: @TEXT_BRIGHT@;
}

QPushButton:pressed {
    background-color: @BG_ALT@;
}

QPushButton:disabled {
    color: @TEXT_DISABLED@;
    background-color: @BG_ALT@;
    border-color: @BG_ELEVATED@;
}

QPushButton#clearBindingButton,
QPushButton#resetBindingButton {
    padding: 0 0 3px 0;
    border-radius: 11px;
    font-weight: bold;
    font-size: 14px;
}

QPushButton#clearBindingButton:hover {
    background-color: #4a2020;
    border-color: #6a2a2a;
    color: #ffffff;
}

QPushButton#resetBindingButton:hover {
    background-color: #204a3a;
    border-color: #2a6a52;
    color: #ffffff;
}

/* Settings controls */
QGroupBox {
    background-color: @BG_ELEVATED@;
    color: @TEXT_BRIGHT@;
    border: 1px solid @BORDER@;
    border-radius: 6px;
    margin-top: 10px;
    padding-top: 10px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 8px;
    padding: 0 4px;
}

QCheckBox {
    spacing: 8px;
}

QCheckBox:disabled {
    color: @TEXT_DISABLED@;
    font-style: italic;
}

QCheckBox::indicator {
    width: 15px;
    height: 15px;
    border: 1px solid @BORDER_LIGHT@;
    border-radius: 3px;
    background-color: @BG_PANEL@;
}

QCheckBox::indicator:hover {
    border-color: @ACCENT@;
}

QCheckBox::indicator:checked {
    background-color: @ACCENT@;
    border-color: @ACCENT@;
    image: url(:/icons/checkwhite.svg);
}

QCheckBox::indicator:disabled {
    border-color: @BORDER@;
    background-color: @BG_ALT@;
}

QComboBox,
QLineEdit,
QSpinBox,
QDoubleSpinBox {
    background-color: @BG_ELEVATED@;
    border: 1px solid @BORDER_LIGHT@;
    border-radius: 6px;
    padding: 4px 8px;
    color: @TEXT@;
}

QComboBox:hover,
QLineEdit:hover,
QSpinBox:hover,
QDoubleSpinBox:hover {
    border-color: @ACCENT@;
}

QComboBox:disabled,
QLineEdit:disabled,
QSpinBox:disabled,
QDoubleSpinBox:disabled {
    color: @TEXT_DISABLED@;
    background-color: @BG_ALT@;
    border-color: @BG_ELEVATED@;
}

QComboBox::drop-down {
    border: none;
    width: 20px;
}

QComboBox QAbstractItemView {
    background-color: @BG_PANEL@;
    border: 1px solid @BORDER@;
    color: @TEXT@;
    selection-background-color: @BORDER@;
    selection-color: @TEXT_BRIGHT@;
    outline: none;
}

QSpinBox::up-button,
QSpinBox::down-button,
QDoubleSpinBox::up-button,
QDoubleSpinBox::down-button {
    width: 18px;
    background-color: @BG_ELEVATED@;
    border-left: 1px solid @BORDER_LIGHT@;
    subcontrol-origin: border;
}

QSpinBox::up-button,
QDoubleSpinBox::up-button {
    subcontrol-position: top right;
    border-top-right-radius: 6px;
}

QSpinBox::down-button,
QDoubleSpinBox::down-button {
    subcontrol-position: bottom right;
    border-bottom-right-radius: 6px;
}

QSpinBox::up-button:hover,
QSpinBox::down-button:hover,
QDoubleSpinBox::up-button:hover,
QDoubleSpinBox::down-button:hover {
    background-color: @BORDER@;
}

QSpinBox::up-arrow,
QDoubleSpinBox::up-arrow {
    image: url(:/icons/arrowup@SHADE@.svg);
    width: 12px;
    height: 12px;
}

QSpinBox::down-arrow,
QDoubleSpinBox::down-arrow,
QComboBox::down-arrow {
    image: url(:/icons/arrowdown@SHADE@.svg);
    width: 12px;
    height: 12px;
}

QSlider::groove:horizontal {
    background-color: @BG_ALT@;
    height: 4px;
    border-radius: 2px;
}

QSlider::handle:horizontal {
    background-color: @ACCENT@;
    width: 14px;
    height: 14px;
    margin: -6px 0;
    border-radius: 7px;
}

QSlider::handle:horizontal:hover {
    background-color: @ACCENT_LIGHTER@;
}

QSlider::sub-page:horizontal {
    background-color: @ACCENT_DARK@;
    border-radius: 2px;
}

QScrollBar:vertical {
    background-color: @BG_ALT@;
    width: 12px;
    margin: 0;
}

QScrollBar:horizontal {
    background-color: @BG_ALT@;
    height: 12px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background-color: @BORDER_LIGHT@;
    border-radius: 4px;
    min-height: 30px;
    margin: 2px;
}

QScrollBar::handle:horizontal {
    background-color: @BORDER_LIGHT@;
    border-radius: 4px;
    min-width: 30px;
    margin: 2px;
}

QScrollBar::add-line,
QScrollBar::sub-line {
    background: none;
    width: 0;
    height: 0;
}

/* Library page */
#libraryPage {
    background-color: @BG_WINDOW@;
}

#libraryHeader {
    background-color: @BG_ALT@;
    border-bottom: 1px solid @BORDER@;
}

#libraryTitle {
    color: @TEXT_BRIGHT@;
    font-size: 13pt;
    font-weight: 600;
    padding: 12px 16px;
}

#librarySearch {
    background-color: @BG_PANEL@;
    border: 1px solid @BORDER@;
    border-radius: 6px;
    padding: 6px 10px;
    selection-background-color: @BORDER_LIGHT@;
}

#librarySearch:focus {
    border-color: @ACCENT@;
}

#libraryDropZone {
    background-color: @BG_PANEL@;
    border: 2px dashed @BORDER_LIGHT@;
    border-radius: 12px;
}

#libraryEmptyTitle {
    color: @TEXT@;
    font-size: 14pt;
    font-weight: 500;
}

#libraryEmptyHint {
    color: @TEXT_MUTED@;
    font-size: 10pt;
}

QTableView#gameTable {
    background-color: @BG_WINDOW@;
    alternate-background-color: @BG_ALT@;
    border: none;
    selection-background-color: @ACCENT_DARK@;
    selection-color: #ffffff;
    outline: 0;
}

QTableView#gameTable::item {
    padding: 6px 8px;
    border: none;
}

QTableView#gameTable::item:hover {
    background-color: @BG_ELEVATED@;
}

QTableView#gameTable::item:selected {
    background-color: @ACCENT_DARK@;
    color: #ffffff;
}

QHeaderView#gameHeader::section {
    padding: 8px 10px;
    font-size: 9pt;
}

QHeaderView#gameHeader::section:hover {
    background-color: @BG_ELEVATED@;
    color: @ACCENT@;
}